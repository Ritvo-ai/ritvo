{% macro shape(kind) %}
{% if kind in ("allow", "ok") %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="currentColor"/></svg>
{% elif kind in ("ask", "medium") %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 1 10 9H0Z" fill="currentColor"/></svg>
{% elif kind in ("gap", "high") %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0 10 5 5 10 0 5Z" fill="currentColor"/></svg>
{% elif kind == "low" %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="currentColor"/></svg>
{% else %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><rect x="1" y="1" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 1.5"/></svg>
{% endif %}
{% endmacro %}
{% macro level(kind) %}<span class="chip lv-{{ kind }}">{{ shape("gap" if kind == "gap" else "unknown") }}{{ "Gap" if kind == "gap" else "Not known" }}</span>{% endmacro %}
{% macro tier(name) %}<span class="chip tier-{{ name or 'unknown' }}">{{ shape(name or "unknown") }}{{ (name or "unknown") | capitalize }}</span>{% endmacro %}
{% macro decision(name) %}<span class="chip dec-{{ name }}">{{ shape(name) }}{{ name | capitalize }}</span>{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ritvo authority gap report</title>
<style>
:root {
  --bg: #F2F5F6; --surface: #FFFFFF; --ink: #12222C; --ink2: #44565F; --muted: #5A6B74;
  --line: #D2DBDF; --line2: #E6ECEF; --accent: #0B6B7C;
  --t-low: #CFE5EA; --t-low-ink: #12222C;
  --t-med: #5BA3B3; --t-med-ink: #06202A;
  --t-high: #0B4F63; --t-high-ink: #FFFFFF;
  --p1: #B3261E; --p1-bg: #FBE9E7; --p2: #8F4C00; --p2-bg: #FCEFD9;
  --ok: #276B43; --ok-bg: #E4F2EA; --unk: #6B7A82;
  --f-body: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --f-mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0E1A21; --surface: #15252E; --ink: #E6EEF1; --ink2: #B4C3CA; --muted: #8DA0A9;
    --line: #2A3C46; --line2: #20313A; --accent: #5EC0D1;
    --t-low: #24505E; --t-low-ink: #E6EEF1;
    --t-med: #3F8CA0; --t-med-ink: #05161C;
    --t-high: #9ED6E4; --t-high-ink: #05161C;
    --p1: #FF8A80; --p1-bg: #3A1E1D; --p2: #F2B35E; --p2-bg: #3A2B14;
    --ok: #7FD1A0; --ok-bg: #173226; --unk: #8DA0A9;
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.55; padding: 16px 16px 56px; }
.wrap { max-width: 1120px; margin-inline: auto; display: flex; flex-direction: column; gap: 32px; }
h1, h2, h3 { margin: 0; line-height: 1.2; letter-spacing: -0.01em; }
p { margin: 0; }
code, .mono { font-family: var(--f-mono); font-size: 0.86em; }
.dim { color: var(--muted); }
.desc { color: var(--muted); font-family: var(--f-body); font-size: 12px; font-weight: 400; text-transform: none; letter-spacing: 0; white-space: normal; }
.cover { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px; padding-block: 8px 24px; border-bottom: 2px solid var(--ink); }
.eyebrow { font-family: var(--f-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
.cover h1 { font-size: clamp(28px, 5vw, 44px); font-weight: 700; line-height: 1.08; }
.lede { margin-top: 16px; font-size: 17px; max-width: 52ch; color: var(--ink2); }
.meta { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: 16px; row-gap: 6px; align-content: start; font-size: 13px; }
.meta dt { color: var(--muted); font-family: var(--f-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: .06em; padding-top: 2px; }
.meta dd { margin: 0; font-family: var(--f-mono); font-size: 12.5px; overflow-wrap: anywhere; }
.section { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.section > h2 { font-size: 20px; font-weight: 700; }
.section > p { color: var(--ink2); max-width: 74ch; }
.tablewrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th { text-align: left; font-family: var(--f-mono); font-weight: 500; font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); padding: 10px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; background: var(--surface); }
td { padding: 10px 14px; border-bottom: 1px solid var(--line2); vertical-align: top; overflow-wrap: anywhere; }
tr:last-child td { border-bottom: 0; }
td.id { font-family: var(--f-mono); font-size: 12.5px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.grid td, .grid th { text-align: center; }
.grid td:first-child, .grid th:first-child { text-align: left; }
.chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 4px; white-space: nowrap; line-height: 1.5; }
.ico { width: 10px; height: 10px; display: inline-block; flex: none; }
.lv-gap { background: var(--p1-bg); color: var(--p1); }
.lv-needs_validation { background: var(--p2-bg); color: var(--p2); }
.tier-low { background: var(--t-low); color: var(--t-low-ink); }
.tier-medium { background: var(--t-med); color: var(--t-med-ink); }
.tier-high { background: var(--t-high); color: var(--t-high-ink); }
.tier-unknown { background: var(--surface); color: var(--ink2); border: 1px dashed var(--unk); }
.dec-allow { background: var(--ok-bg); color: var(--ok); }
.dec-ask { background: var(--p2-bg); color: var(--p2); }
.findings { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
.finding { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 4px 20px; padding: 16px 18px; border-bottom: 1px solid var(--line2); }
.finding:last-child { border-bottom: 0; }
.finding .rule { font-family: var(--f-mono); font-size: 12.5px; }
.finding .subj { font-family: var(--f-mono); font-size: 13px; font-weight: 500; overflow-wrap: anywhere; }
.finding dl { margin: 8px 0 0; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 4px 12px; font-size: 13.5px; }
.finding dt { color: var(--muted); font-family: var(--f-mono); font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; padding-top: 2px; }
.finding dd { margin: 0; }
.empty { padding: 14px 16px; color: var(--ink2); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
.note { font-size: 13.5px; color: var(--ink2); border-left: 3px solid var(--line); padding-left: 12px; max-width: 78ch; }
.foot { font-size: 12.5px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 14px; display: flex; gap: 8px 24px; flex-wrap: wrap; justify-content: space-between; }
@media (max-width: 820px) {
  .cover { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .finding { grid-template-columns: minmax(0, 1fr); }
}
@page { size: A4; margin: 12mm; }
@media print {
  :root {
    --bg: #FFFFFF; --surface: #FFFFFF; --ink: #12222C; --ink2: #44565F; --muted: #5A6B74;
    --line: #C5CFD4; --line2: #E1E7EA; --accent: #0B6B7C;
    --t-low: #CFE5EA; --t-low-ink: #12222C; --t-med: #5BA3B3; --t-med-ink: #06202A;
    --t-high: #0B4F63; --t-high-ink: #FFFFFF;
    --p1: #B3261E; --p1-bg: #FBE9E7; --p2: #8F4C00; --p2-bg: #FCEFD9;
    --ok: #276B43; --ok-bg: #E4F2EA; --unk: #6B7A82;
  }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { padding: 0; font-size: 10.5pt; }
  tr, .finding { break-inside: avoid; }
  .tablewrap { overflow: visible; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="cover">
    <div>
      <p class="eyebrow">Ritvo · Authority gap report</p>
      <h1>Where authority is missing, and what is not known</h1>
      <p class="lede">{{ gaps }} {{ "gap" if gaps == 1 else "gaps" }} and {{ unknown }} not known, from {{ agents }} {{ "agent" if agents == 1 else "agents" }}, {{ tools }} {{ "tool" if tools == 1 else "tools" }} and {{ people }} {{ "person" if people == 1 else "people" }}. A gap is a control known to be missing. Not known means the files do not say.</p>
    </div>
    <dl class="meta">
      <dt>Generated</dt><dd>{{ diagnosis.generated_at }}</dd>
      <dt>Tool</dt><dd>{{ diagnosis.tool }}</dd>
      <dt>Diagnosis</dt><dd>sha256 {{ diagnosis_sha256 }}</dd>
      {% for input in diagnosis.inputs %}
      <dt>Input</dt><dd>{{ input.file }} · sha256 {{ input.sha256 }}</dd>
      {% endfor %}
    </dl>
  </header>

  <section class="section">
    <h2>By rule</h2>
    <div class="tablewrap" tabindex="0"><table>
      <thead><tr><th>Rule</th><th>What it checks</th><th class="num">Gaps</th><th class="num">Not known</th></tr></thead>
      <tbody>
      {% for count in counts %}
      <tr><td class="id">{{ count.rule }}</td><td>{{ count.title }}</td><td class="num">{{ count.gaps }}</td><td class="num">{{ count.unknown }}</td></tr>
      {% endfor %}
      </tbody></table></div>
  </section>

  <section class="section">
    <h2>Findings</h2>
    {% if findings %}
    <div class="findings">
      {% for finding in findings %}
      <div class="finding"><div>{{ level(finding.level) }}</div><div>
        <div class="rule dim">{{ finding.rule }} · {{ titles[finding.rule] }}</div>
        <div class="subj">{{ finding.subject }}</div>
        <dl>
          <dt>Saw</dt><dd>{{ finding.saw }}</dd>
          <dt>Why</dt><dd>{{ finding.why }}</dd>
          <dt>Next</dt><dd>{{ finding.next }}</dd>
          <dt>Basis</dt><dd>{% if finding.bases %}{{ finding.bases[-1] }} (weakest){% if finding.bases | length > 1 %}; also {{ finding.bases[:-1] | join(", ") }}{% endif %}{% else %}none; no fact was read{% endif %}</dd>
          {% if finding.needs %}<dt>Needs</dt><dd>{{ finding.needs | join("; ") }}</dd>{% endif %}
        </dl>
      </div></div>
      {% endfor %}
    </div>
    {% else %}
    <p class="empty">No findings. That means the rules found nothing in the files given, not that nothing is wrong.</p>
    {% endif %}
  </section>

  <section class="section">
    <h2>What each agent can use, and what the draft proposes</h2>
    {% if grid.rows and grid.tools %}
    <div class="tablewrap" tabindex="0"><table class="grid">
      <thead><tr><th>Agent</th>{% for tool in grid.tools %}<th>{{ tool.id }}{% if tool.description %}<br><span class="desc">{{ tool.description }}</span>{% endif %}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in grid.rows %}
      <tr><td class="id">{{ row.agent }}{% if row.name %}<br><span class="desc">{{ row.name }}</span>{% endif %}</td>{% for cell in row.cells %}<td>{% if cell %}{{ decision(cell.decision) }} {{ tier(cell.tier) }}{% else %}<span class="dim">not listed</span>{% endif %}</td>{% endfor %}</tr>
      {% endfor %}
      </tbody></table></div>
    <p class="note">A tool an agent can use today is read as allowed with no ask in front of it. The draft proposes an ask for high and medium tools and for a tier that is not known, and allow only for low.</p>
    {% else %}
    <p class="empty">No agent and tool pairs to show. Give agents.csv with the tools each agent can use.</p>
    {% endif %}
  </section>

  <section class="section">
    <h2>What the draft does not hold</h2>
    <div class="tablewrap" tabindex="0"><table>
      <thead><tr><th>Section</th><th>Why</th></tr></thead>
      <tbody>{% for item in diagnosis.not_drafted %}<tr><td class="id">{{ item.section }}</td><td>{{ item.reason }}</td></tr>{% endfor %}</tbody></table></div>
    {% for note in diagnosis.notes %}<p class="note">{{ note }}</p>{% endfor %}
  </section>

  <footer class="foot">
    <span>Generated on this machine by <code>ritvo diagnose</code> {{ version }}. Nothing was uploaded, and this file makes no network requests.</span>
    <span>The intake files are self-reported. The draft is a proposal and approves nothing. This report is not a conformity assessment.</span>
  </footer>
</div>
</body>
</html>
