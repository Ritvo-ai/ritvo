{% macro shape(level) %}
{% if level == "in_place" %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4.5" fill="currentColor"/></svg>
{% elif level == "partial" %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 1 10 9H0Z" fill="currentColor"/></svg>
{% elif level == "gap" %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 0 10 5 5 10 0 5Z" fill="currentColor"/></svg>
{% elif level == "needs_validation" %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
{% else %}
<svg class="ico" viewBox="0 0 10 10" aria-hidden="true"><rect x="1" y="1" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 1.5"/></svg>
{% endif %}
{% endmacro %}
{% macro chip(level) %}<span class="chip st-{{ level }}">{{ shape(level) }}{{ labels[level] }}</span>{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Authority gap review{% if review.organisation %}: {{ review.organisation }}{% endif %}</title>
<style>
:root {
  --bg: #F2F5F6; --surface: #FFFFFF; --ink: #12222C; --ink2: #44565F; --muted: #5F7079;
  --line: #D2DBDF; --line2: #E6ECEF; --accent: #0B6B7C;
  --p1: #B3261E; --p1-bg: #FBE9E7; --p2: #9A5200; --p2-bg: #FCEFD9;
  --ok: #2E7D4F; --ok-bg: #E4F2EA; --unk: #8A979D;
  --nv: #3A55A0; --nv-bg: #E7ECF8;
  --f-body: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --f-mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0E1A21; --surface: #15252E; --ink: #E6EEF1; --ink2: #B4C3CA; --muted: #8DA0A9;
    --line: #2A3C46; --line2: #20313A; --accent: #5EC0D1;
    --p1: #FF8A80; --p1-bg: #3A1E1D; --p2: #F2B35E; --p2-bg: #3A2B14;
    --ok: #7FD1A0; --ok-bg: #173226; --unk: #6F8088;
    --nv: #A9BCF2; --nv-bg: #1E2840;
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.5; padding: 16px 16px 48px; }
.wrap { max-width: 960px; margin-inline: auto; display: flex; flex-direction: column; gap: 24px; }
h1, h2, h3 { margin: 0; line-height: 1.2; }
p { margin: 0; }
code, .mono { font-family: var(--f-mono); font-size: 0.86em; }
.cover { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 24px; padding-bottom: 20px; border-bottom: 2px solid var(--ink); }
.eyebrow { font-family: var(--f-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
.cover h1 { font-size: clamp(28px, 4.5vw, 40px); font-weight: 700; }
.lede { margin-top: 12px; font-size: 16px; color: var(--ink2); max-width: 52ch; }
.meta { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 14px; align-content: start; font-size: 13px; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; overflow-wrap: anywhere; }
.areas { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
.area { padding: 14px 16px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
.area:first-child { border-left: 0; }
.area h2 { font-size: 14px; font-weight: 600; }
.area .count { font-size: 12.5px; color: var(--ink2); }
.area .count .evidence { display: block; }
.area .count .sep { display: none; }
.chip { display: inline-flex; align-items: center; gap: 6px; align-self: flex-start; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 4px; white-space: nowrap; }
.st-in_place { background: var(--ok-bg); color: var(--ok); }
.st-partial { background: var(--p2-bg); color: var(--p2); }
.st-gap { background: var(--p1-bg); color: var(--p1); }
.st-needs_validation { background: var(--nv-bg); color: var(--nv); }
.st-not_answered { background: var(--line2); color: var(--ink2); }
.ico { width: 10px; height: 10px; flex: none; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 13px; color: var(--ink2); }
.section { display: flex; flex-direction: column; gap: 10px; }
.section > h2 { font-size: 18px; }
.findings { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
.finding { padding: 14px 16px; border-bottom: 1px solid var(--line2); display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 4px 16px; }
.finding:last-child { border-bottom: 0; }
.finding h3 { font-size: 15px; font-weight: 600; }
.finding .area-name { font-size: 12.5px; color: var(--muted); }
.finding dl { margin: 6px 0 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 4px 12px; font-size: 13.5px; }
.finding dt { color: var(--muted); }
.finding dd { margin: 0; overflow-wrap: anywhere; }
.none { padding: 14px 16px; color: var(--ink2); }
.foot { font-size: 12.5px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; display: flex; flex-direction: column; gap: 4px; }
@media screen and (max-width: 820px) {
  .cover { grid-template-columns: minmax(0, 1fr); }
  .areas { grid-template-columns: minmax(0, 1fr); }
  .area { border-left: 0; border-top: 1px solid var(--line); }
  .area:first-child { border-top: 0; }
  .finding { grid-template-columns: minmax(0, 1fr); }
}
@page { size: A4; margin: 8mm; }
@media print {
  :root {
    --bg: #fff; --surface: #fff; --ink: #12222C; --ink2: #44565F; --muted: #5F7079;
    --line: #C5CFD4; --line2: #E1E7EA; --accent: #0B6B7C;
    --p1: #B3261E; --p1-bg: #FBE9E7; --p2: #9A5200; --p2-bg: #FCEFD9;
    --ok: #2E7D4F; --ok-bg: #E4F2EA; --unk: #8A979D;
    --nv: #3A55A0; --nv-bg: #E7ECF8;
  }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { padding: 0; font-size: 6.8pt; line-height: 1.24; }
  .wrap { max-width: none; gap: 6px; }
  .cover { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding-bottom: 5px; gap: 12px; border-bottom-width: 1.5px; }
  .cover h1 { font-size: 15pt; }
  .eyebrow { font-size: 6.5pt; margin-bottom: 1px; }
  .lede { font-size: 7.5pt; margin-top: 3px; }
  .meta { font-size: 6.5pt; gap: 0 8px; }
  .areas { border-radius: 4px; }
  .area { padding: 4px 6px; gap: 2px; }
  .area h2 { font-size: 7pt; }
  .area .count { font-size: 6.3pt; }
  .chip { font-size: 6.3pt; padding: 0 4px; gap: 3px; border-radius: 3px; }
  .ico { width: 6px; height: 6px; }
  .legend { font-size: 6.3pt; gap: 1px 10px; }
  .section { gap: 3px; }
  .section > h2 { font-size: 8.5pt; }
  .findings { column-count: 3; column-gap: 0; border-radius: 4px; }
  .finding { break-inside: avoid; display: block; padding: 2px 5px 3px; }
  .finding:last-child { border-bottom: 1px solid var(--line2); }
  .finding .area-name { display: none; }
  .finding h3 { font-size: 6.6pt; margin-top: 1px; }
  .finding dl { display: block; margin-top: 1px; font-size: 6.1pt; }
  .finding dt { display: inline; font-weight: 600; color: var(--ink2); }
  .finding dt::after { content: ": "; }
  .finding dd { display: inline; }
  .finding dd::after { content: ""; display: block; }
  .finding dd.answer::after { content: "  "; display: inline; white-space: pre; }
  .area .count .evidence { display: inline; }
  .area .count .sep { display: inline; }
  /* Evidence is free text of any length; print shows the basis, the screen shows both. */
  .evidence-ref { display: none; }
  .foot { font-size: 6.2pt; padding-top: 3px; gap: 0; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="cover">
    <div>
      <p class="eyebrow">Authority gap review</p>
      <h1>{{ review.organisation or "Authority gap review" }}</h1>
      <p class="lede">
        {% if gap_areas %}
        {{ gap_areas }} of {{ review.areas | length }} areas {{ "has" if gap_areas == 1 else "have" }} a gap.
        {% else %}
        No area has a gap.
        {% endif %}
        {{ review.answered }} of {{ review.total }} questions answered,
        {{ review.evidence }} backed by evidence.
        Each area takes the level of its weakest answer.
      </p>
    </div>
    <dl class="meta">
      <dt>Date</dt><dd>{{ generated }}</dd>
      <dt>Answers file</dt><dd class="mono">SHA-256 {{ review.answers_sha256 }}</dd>
      {% if review.answers_version == 0 %}
      <dt>File version</dt><dd>review_version 0: unknown answers were read as needs validation, not as a gap</dd>
      {% endif %}
      <dt>Questions</dt><dd>{{ review.answered }} of {{ review.total }} answered</dd>
      <dt>Produced by</dt><dd>ritvo review {{ version }}</dd>
    </dl>
  </header>

  <section class="areas" aria-label="Areas">
    {% for area in review.areas %}
    <div class="area">
      <h2>{{ area.area.title }}</h2>
      {{ chip(area.level.value) }}
      <p class="count">
        {{ area.answered }} of {{ area.questions | length }} answered{% if area.incomplete %}, incomplete{% endif %}<span class="sep">. </span>
        <span class="evidence">Evidence: {{ area.evidence }} of {{ area.questions | length }}</span>
      </p>
      {% if area.asserted_cap %}
      <p class="count">Capped at partial: every answer is asserted, with no evidence</p>
      {% endif %}
    </div>
    {% endfor %}
  </section>

  <p class="legend">
    <span>{{ chip("gap") }} known to be missing</span>
    <span>{{ chip("needs_validation") }} not known, or no evidence; not a failure</span>
    <span>{{ chip("partial") }} some agents, some of the time, or informal</span>
    <span>{{ chip("in_place") }} written down, applies to every agent</span>
    <span>{{ chip("not_answered") }} never counted as in place</span>
  </p>

  <section class="section">
    <h2>What to address</h2>
    <div class="findings">
      {% set ns = namespace(shown=0) %}
      {% for area in review.areas %}
      {% for result in area.questions if result.level is not sameas Level.IN_PLACE %}
      {% set ns.shown = ns.shown + 1 %}
      <article class="finding">
        <div>
          {{ chip(result.level.value) }}
          <p class="area-name">{{ area.area.title }}</p>
        </div>
        <div>
          <h3>{{ result.question.text }}</h3>
          <dl>
            <dt>Answer</dt><dd class="answer">{% if result.answer is none %}Not answered{% else %}<code>{{ result.answer }}</code>{% endif %}</dd>
            {% if result.answer is not none %}
            <dt>Basis</dt><dd>{% if result.basis is none %}asserted, no basis given{% else %}<code>{{ result.basis.source }}</code>{% if result.basis.evidence %}<span class="evidence-ref">, <span class="mono">{{ result.basis.evidence }}</span></span>{% endif %}{% endif %}</dd>
            {% endif %}
            {% if result.note %}
            <dt>Note</dt><dd>{{ result.note }}</dd>
            {% endif %}
            <dt>Why it matters</dt><dd>{{ result.question.why }}</dd>
            <dt>Next step</dt><dd>{{ result.question.next_step }}</dd>
          </dl>
        </div>
      </article>
      {% endfor %}
      {% endfor %}
      {% if ns.shown == 0 %}
      <p class="none">Every question is answered as in place.</p>
      {% endif %}
    </div>
  </section>

  <footer class="foot">
    <p>The answers are self-reported. This result is not a conformity assessment and does not test any system.</p>
    <p>Levels: an area with any gap is a gap; an area with unanswered questions, or whose answers are all asserted, cannot be in place. Evidence is a count of answers with a basis of derived or observed. There is no total score.</p>
  </footer>
</div>
</body>
</html>
